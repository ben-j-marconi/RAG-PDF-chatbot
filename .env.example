# ── LLM Provider ────────────────────────────────────────────────────────────────
# "openai" (default dev) or "vertex" (production Gemini on Vertex AI)
LLM_PROVIDER=openai

# OpenAI (dev mode)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Vertex AI / Gemini (production mode — swap LLM_PROVIDER=vertex)
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
VERTEX_MODEL=gemini-2.0-flash-001

# ── Paths ───────────────────────────────────────────────────────────────────────
PDF_DIR=data/pdfs
REGISTRY_PATH=data/registry/document_registry.json
CHROMA_DIR=data/chroma_db
BM25_INDEX_PATH=data/registry/bm25_index.pkl

# ── Retrieval tuning ─────────────────────────────────────────────────────────────
VECTOR_TOP_K=20
BM25_TOP_K=20
RERANK_TOP_K=5

# ── Embedding model ──────────────────────────────────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── Reranker model ───────────────────────────────────────────────────────────────
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# ── Logging ──────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=data/rag_chatbot.log
